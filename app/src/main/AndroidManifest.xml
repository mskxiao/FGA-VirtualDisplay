<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".util.AutomataApplication"
        android:allowBackup="true"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            Android 16 (targetSdk 36) ignores android:screenOrientation, resizeableActivity
            and aspect-ratio restrictions on displays >= 600dp. This property opts out and
            keeps SkillMakerActivity landscape-locked there.
            TODO: this opt-out is ignored at targetSdk 37 - make the Command Editor work in
            portrait / freely resized windows before bumping targetSdk again.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".ui.skill_maker.SkillMakerActivity"
            android:label="Command Editor"
            android:screenOrientation="sensorLandscape" />

        <service
            android:name=".runner.ScriptRunnerService"
            android:foregroundServiceType="mediaProjection|specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows a Play button in front of apps in landscape mode so farming can be started while Fate/Grand Order is open."/>
        </service>

        <service
            android:name=".accessibility.TapperService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/tapper_service" />
        </service>

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <activity
            android:name=".ui.main.MainActivity"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".runner.ScriptRunnerNotification$NotificationReceiver" />

        <!--
            ============================================================
            [FGA-VirtualDisplay] stage 2A probe
            ============================================================

            ProbeHarnessActivity is the harness: it runs on whichever display the
            user is looking at and drives the closed loop. Exported so it can also
            be started from a root shell, which is how three consecutive runs get
            executed without tapping the phone each time.

            ProbeActivity is the target under test. Deliberately NOT exported: it
            must only ever start from our own probe. singleInstance keeps exactly
            one copy, so its static Observer state cannot be split across two
            instances - which would silently make the tap assertions meaningless.
            It is landscape because the virtual display is 1280x720.
        -->
        <activity
            android:name=".probe.ProbeHarnessActivity"
            android:label="VD Probe"
            android:exported="true"
            android:excludeFromRecents="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".probe.ProbeActivity"
            android:label="VD Probe Target"
            android:exported="false"
            android:launchMode="singleInstance"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
    </application>

</manifest>
